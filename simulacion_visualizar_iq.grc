options:
  parameters:
    alias: ''
    author: Mayelin Stefania Aguilar Vasquez
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: Visualizacion de senales IQ pre-computadas del enlace RF CubeSat
      STRaND-1.
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: simulacion_visualizar_iq
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: "Visualizaci\xF3n de Se\xF1al IQ - CubeSat STRaND-1"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: noise_amplitude
  id: variable_qtgui_range
  parameters:
    comment: Control interactivo de la amplitud del ruido AWGN
    gui_hint: 0,0,1,1
    label: Amplitud de ruido
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.0'
    step: '0.005'
    stop: '0.5'
    value: '0.02'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 80]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Frecuencia de muestreo = 9600 bps * 8 muestras/simbolo
    value: '76800'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [240, 8]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: Muestras por simbolo
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [440, 8]
    rotation: 0
    state: enabled
- name: sym_rate
  id: variable
  parameters:
    comment: Tasa de simbolos (baudios]
    value: '9600'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 8]
    rotation: 0
    state: enabled
- name: analog_noise_source_x_0
  id: analog_noise_source_x
  parameters:
