# Copia este archivo a .env y ajusta lo que necesites.

# PostgreSQL. Si no hay servidor accesible la aplicacion cae a SQLite y lo
# registra en el log de arranque.
DATABASE_URL=postgresql+psycopg://strand:strand@localhost:5432/strand1

# SatNOGS Network y SatNOGS DB son instalaciones separadas, con cuentas y tokens
# propios: el token de una no vale en la otra.
#
#   Network (network.satnogs.org) -> observaciones y archivos de demoddata.
#   DB      (db.satnogs.org)      -> telemetria historica y consultas por fecha.
#
# Deja vacio el que no tengas. Un token invalido es peor que ninguno: DB
# responde 401 a la peticion entera, incluidos los endpoints publicos que sin
# token si contestan.
SATNOGS_NETWORK_TOKEN=
SATNOGS_DB_TOKEN=

# Configuracion anterior, con un unico token. Se sigue leyendo como respaldo del
# de Network para no romper instalaciones existentes.
SATNOGS_API_TOKEN=

# Satelite objetivo.
NORAD_ID=39090
SATELLITE_NAME=STRAND-1
