options:
  parameters:
    alias: ''
    author: Mayelin Stefania Aguilar Vasquez
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: Cadena completa de transmision y recepcion BPSK con telemetria real
      STRaND-1.
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
