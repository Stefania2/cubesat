options:
  parameters:
    alias: ''
    author: Mayelin Stefania Aguilar Vasquez
    catch_exceptions: 'True'
    comment: ''
    copyright: ''
    description: Cadena BPSK STRAND-1 corregida - cada byte del .bin es un bit (sin Unpack
      Bits), RRC matched, AWGN con SNR configurable y BER determinista.
    gen_linking: dynamic
    generate_options: qt_gui
    generator_class_name: PythonQtGuiGenerator
    generator_module: gnuradio.grc.workflows.python_qt_gui
    hier_block_src_path: '.:'
    id: cadena_strand1_awgn
    max_nouts: '0'
    output_language: python
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    thread_safe_setters: ''
    title: Cadena BPSK STRAND-1 (bits sueltos, RRC, AWGN)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8.0]
    rotation: 0
    state: enabled

blocks:
- name: import_os
  id: import
  parameters:
    alias: ''
    comment: Resuelve la ruta del .bin sin depender del directorio de trabajo
    imports: import os
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 80.0]
    rotation: 0
    state: enabled
- name: ruta_base
  id: variable
  parameters:
    comment: Carpeta donde vive este flowgraph
    value: os.path.dirname(os.path.realpath(globals().get('__file__', '.')))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [192, 80.0]
    rotation: 0
    state: enabled
- name: snr_db
  id: variable_qtgui_range
  parameters:
    comment: Eb/N0 en dB para el canal AWGN (control interactivo)
    gui_hint: 1,0,1,1
    label: Eb/N0 (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.0'
    step: '0.5'
    stop: '12.0'
    value: '10.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 16.0]
    rotation: 0
    state: enabled
- name: noise_amp
  id: variable
  parameters:
    comment: Amplitud del ruido AWGN calibrada para Eb/N0 pedido (A/(KAPPA*sqrt(2*10^(snr/10))))
    value: A/(KAPPA*(2.0*10.0**(snr_db/10.0))**0.5)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 16.0]
    rotation: 0
    state: enabled
- name: A
  id: variable
  parameters:
    comment: Amplitud de decision medida (pico del filtro matched, gain=8)
    value: '8.00011'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 80.0]
    rotation: 0
    state: enabled
- name: KAPPA
  id: variable
  parameters:
    comment: Sigma_decision = KAPPA * noise_amp (medido empiricamente)
    value: '1.98733'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 80.0]
    rotation: 0
    state: enabled
- name: N
  id: variable
  parameters:
    comment: Numero de bits de frames_STRAND1_bits.bin
    value: '18776'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 16.0]
    rotation: 0
    state: enabled
- name: L
  id: variable
  parameters:
    comment: Cola de ceros para drenar el filtro TX ((ntaps-1)/sps)
    value: '11'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 80.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Frecuencia de muestreo = 9600 * 8
    value: '76800'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 16.0]
    rotation: 0
    state: enabled
- name: sym_rate
  id: variable
  parameters:
    comment: Tasa de simbolos = 9600 baudios
    value: '9600'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 16.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: Muestras por simbolo
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 80.0]
    rotation: 0
    state: enabled
- name: alpha
  id: variable
  parameters:
    comment: Factor de roll-off del filtro RRC
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1128, 16.0]
    rotation: 0
    state: enabled
- name: ntaps
  id: variable
  parameters:
    comment: Numero de taps del RRC (8*11+1)
    value: '89'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1128, 80.0]
    rotation: 0
    state: enabled
- name: blocks_add_xx_0
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: Suma senal + ruido (canal AWGN en banda base compleja)
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 320.0]
    rotation: 0
    state: enabled
- name: analog_noise_source_x_0
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: noise_amp
    comment: Ruido AWGN Gaussiano complejo (amplitud calibrada)
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: '11'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 400.0]
    rotation: 0
    state: enabled
- name: blocks_complex_to_real_0
  id: blocks_complex_to_real
  parameters:
    affinity: ''
    alias: ''
    comment: Extrae componente I (real)
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1624, 320.0]
    rotation: 0
    state: enabled
- name: blocks_delay_0
  id: blocks_delay
  parameters:
    affinity: ''
    alias: ''
    comment: Sintoniza la fase de decimacion a 1 de cada 8 (pico del matched)
    delay: '7'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    showports: 'False'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2200, 480.0]
    rotation: 0
    state: enabled
- name: blocks_file_sink_0
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: Bits recuperados (1 byte = 1 bit)
    file: os.path.join(ruta_base, 'frames_STRAND1_bits_rx.bin')
    maxoutbuf: '0'
    minoutbuf: '0'
    type: byte
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3112, 480.0]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: Telemetria real STRAND-1 (18.776 bytes, cada byte es un bit 0/1)
    file: os.path.join(ruta_base, 'frames_STRAND1_bits.bin')
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'False'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 176.0]
    rotation: 0
    state: enabled
- name: blocks_float_to_complex_0
  id: blocks_float_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: Convierte a complejo (I = senal RRC, Q = 0)
    maxoutbuf: '0'
    minoutbuf: '0'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [960, 256.0]
    rotation: 0
    state: enabled
- name: blocks_keep_one_in_n_0
  id: blocks_keep_one_in_n
  parameters:
    affinity: ''
    alias: ''
    comment: Diezma 8:1 tomando la ultima muestra (muestreo de simbolo)
    maxoutbuf: '0'
    minoutbuf: '0'
    n: sps
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2392, 480.0]
    rotation: 0
    state: enabled
- name: blocks_skiphead_0
  id: blocks_skiphead
  parameters:
    affinity: ''
    alias: ''
    comment: Descarta el transitorio del filtro (Dg = ntaps-1)
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: '11'
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2592, 480.0]
    rotation: 0
    state: enabled
- name: blocks_stream_mux_0
  id: blocks_stream_mux
  parameters:
    affinity: ''
    alias: ''
    comment: Concatena bits + cola de ceros para drenar el filtro TX
    lengths: (N, L)
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 240.0]
    rotation: 0
    state: enabled
- name: blocks_throttle_0
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: Control de velocidad para visualizacion en tiempo real
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1160, 288.0]
    rotation: 0
    state: enabled
- name: blocks_vector_source_x_0
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: Cola de L ceros (drena la respuesta del filtro TX)
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'False'
    tags: '[]'
    type: byte
    vector: '[0]*L'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [96, 352.0]
    rotation: 0
    state: enabled
- name: digital_binary_slicer_fb_0
  id: digital_binary_slicer_fb
  parameters:
    affinity: ''
    alias: ''
    comment: 'Decide bit: 0 si < 0, 1 si >= 0'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2784, 480.0]
    rotation: 0
    state: enabled
- name: digital_chunks_to_symbols_xx_0
  id: digital_chunks_to_symbols_xx
  parameters:
    affinity: ''
    alias: ''
    comment: 'Mapeo BPSK: bit 0 -> -1, bit 1 -> +1 (sin expandir bytes)'
    dimension: '1'
    in_type: byte
    maxoutbuf: '0'
    minoutbuf: '0'
    num_ports: '1'
    out_type: float
    symbol_table: '[-1.0, 1.0]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 240.0]
    rotation: 0
    state: enabled
